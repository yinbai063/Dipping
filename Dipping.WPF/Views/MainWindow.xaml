<Window x:Class="Dipping.WPF.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dipping Monitor"
        Height="760" Width="1280"
        Icon="/Assets/app.ico"
        WindowStartupLocation="CenterScreen"
        Background="#FFF0F0F0">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="180"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="140" MinHeight="48"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FF2D5F8B" Padding="15,10">
            <TextBlock Text="Dipping Monitor" Foreground="White" FontSize="20" FontWeight="Bold"/>
        </Border>

        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="配置" Width="80" Height="35" Margin="0,0,10,0"
                    Command="{Binding OpenConfigCommand}"/>
            <Button Grid.Column="1" Content="相机监控" Width="90" Height="35" Margin="0,0,10,0"
                    Command="{Binding OpenCameraMonitorCommand}"
                    ToolTip="登录左右相机、Live 预览、手动/自动录像。关窗不登出。"/>
            <Button Grid.Column="2" Content="历史查询" Width="90" Height="35" IsEnabled="False"
                    ToolTip="二期：按时间查看通道通/堵与录像。"/>
            <StackPanel Grid.Column="4" Orientation="Horizontal">
                <TextBlock Text="状态：" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center"
                           FontWeight="Bold" Foreground="{Binding StatusMessageBrush}" TextWrapping="Wrap" MaxWidth="520"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="280"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*" MinWidth="200"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" BorderBrush="#FFCCCCCC" BorderThickness="1" Background="White">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#FFE0E0E0" Padding="8,5">
                        <TextBlock Text="最近一轮（一期录像 / 二期检测）" FontWeight="Bold"/>
                    </Border>
                    <TextBlock Grid.Row="1" Margin="12" TextWrapping="Wrap" Foreground="#FF333333"
                               Text="{Binding LastJobSummary}"/>
                </Grid>
            </Border>
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                          ResizeDirection="Columns" Background="#FFC8C8C8" Cursor="SizeWE"
                          ToolTip="拖动以调整通道结果栏宽度"/>
            <Border Grid.Column="2" BorderBrush="#FFCCCCCC" BorderThickness="1" Background="White">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#FFE0E0E0" Padding="8,5">
                        <StackPanel>
                            <TextBlock Text="10 通道检测结果" FontWeight="Bold"/>
                            <TextBlock Text="一期「—」；二期分析后显示通/堵" Foreground="#FF666666" FontSize="11"/>
                        </StackPanel>
                    </Border>
                    <DataGrid ItemsSource="{Binding Channels}" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" CanUserAddRows="False" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="36"/>
                            <DataGridTextColumn Header="左" Binding="{Binding LeftStatus}" Width="*"/>
                            <DataGridTextColumn Header="右" Binding="{Binding RightStatus}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>

        <GridSplitter Grid.Row="3" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      ResizeDirection="Rows" Background="#FFC8C8C8" Cursor="SizeNS"
                      ToolTip="拖动以调整日志高度"/>

        <Border Grid.Row="4" Margin="10,0,10,10" BorderBrush="#FFCCCCCC" BorderThickness="1" Background="White">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#FFE0E0E0" Padding="8,5">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="复制日志" Width="80" Height="24"
                                Command="{Binding CopyLogCommand}"/>
                        <TextBlock Text="调试日志（可全选复制）" FontWeight="Bold" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>
                <TextBox x:Name="DebugLogBox" Grid.Row="1"
                         Text="{Binding LogText, Mode=OneWay}"
                         IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas" FontSize="12" BorderThickness="0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
