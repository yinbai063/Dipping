<Window x:Class="Dipping.WPF.Views.ConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="系统配置"
        Height="576" Width="720" MinWidth="520" MinHeight="360"
        Icon="/Assets/app.ico"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="0,0,16,0" Foreground="Gray"/>
            <Button Content="保存" Command="{Binding SaveCommand}" Width="88" Height="26" Margin="0,0,8,0"/>
            <Button Content="关闭" Width="88" Height="26" IsCancel="True" Click="Close_Click"/>
        </StackPanel>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <ScrollViewer.Resources>
                <Style TargetType="TextBox">
                    <Setter Property="Height" Value="22"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="Padding" Value="4,1"/>
                </Style>
                <Style TargetType="ComboBox">
                    <Setter Property="Height" Value="22"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                </Style>
            </ScrollViewer.Resources>
            <Grid Width="640" MinWidth="640" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="500"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="左相机 IP" VerticalAlignment="Center"/>
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding LeftIp}" Height="22" Width="280"
                         HorizontalAlignment="Left" VerticalContentAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Grid.Row="1" Text="右相机 IP" VerticalAlignment="Center"/>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding RightIp}" Height="22" Width="280"
                         HorizontalAlignment="Left" VerticalContentAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Grid.Row="2" Text="录像时长(秒)" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBox Text="{Binding DurationSeconds, UpdateSourceTrigger=LostFocus}" Height="22" Width="160"
                             VerticalContentAlignment="Center"
                             ToolTip="一次录像时长，到时自动停并回到 Live。不能超过右侧上限。"/>
                    <TextBlock Text="上限" VerticalAlignment="Center" Margin="10,0,6,0"/>
                    <TextBox Text="{Binding DurationLimitSeconds, UpdateSourceTrigger=LostFocus}"
                             Height="22" Width="80" VerticalContentAlignment="Center"
                             ToolTip="录像时长上限，默认 60 秒，可改。"/>
                </StackPanel>
                <TextBlock Grid.Row="3" Text="录像保存目录" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBox Text="{Binding LocalFolder, UpdateSourceTrigger=PropertyChanged}"
                             Height="22" Width="420" VerticalContentAlignment="Center"
                             ToolTip="空则用程序目录 Data\Videos"/>
                    <Button Width="32" Height="22" Margin="6,0,0,0"
                            ToolTip="选择录像保存目录"
                            Command="{Binding BrowseLocalFolderCommand}">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8DA;" FontSize="16"/>
                    </Button>
                </StackPanel>
                <TextBlock Grid.Row="4" Text="共享目录" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBox Text="{Binding ShareFolder, UpdateSourceTrigger=PropertyChanged}"
                             Height="22" Width="420" VerticalContentAlignment="Center"
                             ToolTip="UNC，如 \\host\DippingClips。空则不复制"/>
                    <Button Width="32" Height="22" Margin="6,0,0,0"
                            ToolTip="选择网络共享目录"
                            Command="{Binding BrowseShareFolderCommand}">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8DA;" FontSize="16"/>
                    </Button>
                </StackPanel>
                <TextBlock Grid.Row="5" Text="存图目录" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBox Text="{Binding PhotoFolder, UpdateSourceTrigger=PropertyChanged}"
                             Height="22" Width="420" VerticalContentAlignment="Center"
                             ToolTip="拍照/连拍保存。空则用程序目录 Data\Images"/>
                    <Button Width="32" Height="22" Margin="6,0,0,0"
                            ToolTip="选择存图目录"
                            Command="{Binding BrowsePhotoFolderCommand}">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8DA;" FontSize="16"/>
                    </Button>
                </StackPanel>
                <TextBlock Grid.Row="6" Text="连拍张数" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBox Text="{Binding BurstCount, UpdateSourceTrigger=LostFocus}" Height="22" Width="160"
                             VerticalContentAlignment="Center"
                             ToolTip="一次连拍张数，默认 5。不能超过右侧上限。"/>
                    <TextBlock Text="上限" VerticalAlignment="Center" Margin="10,0,6,0"/>
                    <TextBox Text="{Binding BurstCountLimit, UpdateSourceTrigger=LostFocus}"
                             Height="22" Width="80" VerticalContentAlignment="Center"
                             ToolTip="连拍张数上限，默认 200，可改。要拍更多张时先改上限再填张数。"/>
                </StackPanel>
                <TextBlock Grid.Row="7" Text="连拍间隔(毫秒)" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBox Text="{Binding BurstIntervalMs}" Height="22" Width="160"
                             VerticalContentAlignment="Center"
                             IsEnabled="{Binding CanEditBurstInterval}"
                             ToolTip="相邻两张开始拍摄的间隔，50～10000 毫秒。勾选「最快」后不使用。"/>
                    <CheckBox Content="最快" VerticalAlignment="Center" Margin="10,0,0,0"
                              IsChecked="{Binding BurstFastest}"
                              ToolTip="不再按间隔等待：有图就保存并立刻拍下一张，与 NCM 连拍「最快」相同。"/>
                </StackPanel>
                <TextBlock Grid.Row="8" Text="自动信号源" VerticalAlignment="Center"/>
                <ComboBox Grid.Row="8" Grid.Column="1" ItemsSource="{Binding TriggerSources}"
                          SelectedItem="{Binding TriggerSource}" Height="22" Width="200"
                          HorizontalAlignment="Left" Margin="0,0,0,8"/>
                <TextBlock Grid.Row="9" Text="TCP 端口" VerticalAlignment="Top" Margin="0,6,0,0"/>
                <StackPanel Grid.Row="9" Grid.Column="1" Margin="0,0,0,8">
                    <TextBox Text="{Binding TcpPort}" Height="22" Width="120"
                             HorizontalAlignment="Left" VerticalContentAlignment="Center"
                             ToolTip="本机 TCP 监听此端口。左右相机指令不同，须带换行。关闭 Dipping 后调试助手须断开再连。"/>
                    <TextBlock Margin="0,6,0,0" Foreground="#555" FontSize="12" TextWrapping="Wrap"
                               Text="开录指令（一行，末尾回车换行）。左右相机完全独立，各算各的次数："/>
                    <TextBlock Margin="0,4,0,0" FontFamily="Consolas" FontSize="12"
                               Text="左相机：REC_START_DIPPING_L"/>
                    <TextBlock Margin="0,2,0,0" FontFamily="Consolas" FontSize="12"
                               Text="右相机：REC_START_DIPPING_R"/>
                </StackPanel>
                <TextBlock Grid.Row="10" Text="PLC 地址" VerticalAlignment="Center"/>
                <TextBox Grid.Row="10" Grid.Column="1" Text="{Binding PlcHost}" Height="22" Width="280"
                         HorizontalAlignment="Left" VerticalContentAlignment="Center" Margin="0,0,0,8"
                         ToolTip="一期占位，协议未定"/>
                <TextBlock Grid.Row="11" Text="自动录像时段" VerticalAlignment="Top" Margin="0,6,0,0"/>
                <StackPanel Grid.Row="11" Grid.Column="1" Margin="0,0,0,8">
                    <CheckBox Content="自动录像时按时段和次数限制"
                              IsChecked="{Binding ScheduleEnabled}"
                              VerticalAlignment="Center"
                              ToolTip="勾选后按下面时段表限制自动录像；不勾选则不使用此功能，自动录像不受时段和次数限制。表格随时可改。到点不会自动开录。手动录像不受此表限制。"/>
                    <TextBlock Text="每行一个两小时时段。左右相机各自计数。未勾选或该相机次数用尽时，收到对应开录指令也不录像。"
                               Foreground="Gray" FontSize="11" Margin="0,6,0,6" TextWrapping="Wrap"/>
                    <DataGrid ItemsSource="{Binding ScheduleWindows}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeRows="False"
                              CanUserResizeColumns="False"
                              HeadersVisibility="Column"
                              RowHeaderWidth="0"
                              GridLinesVisibility="Horizontal"
                              SelectionMode="Single"
                              Width="248"
                              HorizontalAlignment="Left"
                              Height="256"
                              MinRowHeight="22">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="序号" Binding="{Binding Index}" IsReadOnly="True" Width="36"/>
                            <DataGridCheckBoxColumn Header="启用" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="40">
                                <DataGridCheckBoxColumn.ElementStyle>
                                    <Style TargetType="CheckBox">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridCheckBoxColumn.ElementStyle>
                            </DataGridCheckBoxColumn>
                            <DataGridTextColumn Header="时间段" Binding="{Binding TimeRange, UpdateSourceTrigger=LostFocus}" Width="108"/>
                            <DataGridTextColumn Header="次数" Binding="{Binding MaxCount, UpdateSourceTrigger=LostFocus}" Width="40"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
