<UserControl x:Class="Dipping.WPF.Views.CameraImagePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <Border BorderBrush="#FFCCCCCC" BorderThickness="1" Background="White">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#FFE0E0E0" Padding="8,6">
                <DockPanel>
                    <CheckBox DockPanel.Dock="Right"
                              Content="显示检测结果"
                              VerticalAlignment="Center"
                              Margin="8,0,0,0"
                              IsChecked="{Binding ShowDetectResult}"
                              ToolTip="二期：把通道通/堵叠在画面上。一期勾选无效。"/>
                    <CheckBox DockPanel.Dock="Right"
                              Content="显示通道框"
                              VerticalAlignment="Center"
                              Margin="8,0,0,0"
                              IsChecked="{Binding ShowChannelBoxes}"
                              ToolTip="二期：画出 10 个通道 ROI。一期勾选无效。"/>
                    <StackPanel>
                        <TextBlock FontWeight="Bold" FontSize="14">
                            <Run Text="{Binding Name, Mode=OneWay}"/>
                            <Run Text="  "/>
                            <Run Text="{Binding Ip, Mode=OneWay}" Foreground="#FF555555"/>
                        </TextBlock>
                        <TextBlock Margin="0,2,0,0" TextWrapping="Wrap"
                                   Text="{Binding ImageStatus}"
                                   Foreground="{Binding StatusBrush}"/>
                        <TextBlock Margin="0,2,0,0" Foreground="#FF1B4F72" TextWrapping="Wrap"
                                   Text="{Binding RateText}"
                                   Visibility="{Binding HasRateText, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border x:Name="ImageViewport"
                    Grid.Row="1"
                    Background="#FF1A1A1A"
                    Margin="4"
                    ClipToBounds="True"
                    Cursor="Cross"
                    ToolTip="滚轮：以鼠标位置缩放；拖动：平移；双击：适应窗口"
                    PreviewMouseWheel="ImageViewport_OnPreviewMouseWheel"
                    MouseLeftButtonDown="ImageViewport_OnMouseLeftButtonDown"
                    MouseMove="ImageViewport_OnMouseMove"
                    MouseLeftButtonUp="ImageViewport_OnMouseLeftButtonUp"
                    LostMouseCapture="ImageViewport_OnLostMouseCapture">
                <Grid>
                    <TextBlock Text="{Binding ImageStatus}"
                               Foreground="#FFAAAAAA"
                               FontSize="13"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="12"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Preview}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Grid x:Name="ImageLayer" RenderTransformOrigin="0,0">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="ImageScale" ScaleX="1" ScaleY="1"/>
                                <TranslateTransform x:Name="ImageTranslate"/>
                            </TransformGroup>
                        </Grid.RenderTransform>
                        <Viewbox Stretch="Uniform">
                            <Grid x:Name="PixelLayer" Width="1" Height="1">
                                <Image x:Name="PreviewImageView"
                                       Source="{Binding Preview, NotifyOnTargetUpdated=True}"
                                       Stretch="Fill"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       TargetUpdated="PreviewImageView_OnTargetUpdated"/>
                            </Grid>
                        </Viewbox>
                    </Grid>
                    <Border Background="#CC2B2B2B"
                            CornerRadius="3"
                            Padding="3"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="6"
                            ToolTip="− / + 缩放；数字为相对适应窗口的百分比；1:1 为实际像素">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="−"
                                    Width="26" Height="24"
                                    FontSize="14"
                                    Background="#FF3A3A3A"
                                    Foreground="White"
                                    BorderThickness="0"
                                    ToolTip="缩小"
                                    Click="ZoomOut_Click"/>
                            <TextBlock x:Name="ZoomPercentText"
                                       Text="—"
                                       Width="46"
                                       Margin="2,0"
                                       TextAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="White"
                                       FontSize="12"/>
                            <Button Content="+"
                                    Width="26" Height="24"
                                    FontSize="14"
                                    Background="#FF3A3A3A"
                                    Foreground="White"
                                    BorderThickness="0"
                                    ToolTip="放大"
                                    Click="ZoomIn_Click"/>
                            <Button Content="1:1"
                                    Width="36" Height="24"
                                    Margin="4,0,0,0"
                                    FontSize="11"
                                    Background="#FF3A3A3A"
                                    Foreground="White"
                                    BorderThickness="0"
                                    ToolTip="按实际像素显示"
                                    Click="ZoomActual_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
