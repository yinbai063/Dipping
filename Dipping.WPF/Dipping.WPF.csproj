    </Content>
    <Content Include="GCBase_MD_VC120_v3_0_MVS_v3_1_0.dll">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="GenApi_MD_VC120_v3_0_MVS_v3_1_0.dll">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="libmmd.dll">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="log4cpp_MD_VC120_v3_0_MVS_v3_1_0.dll">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Log_MD_VC120_v3_0_MVS_v3_1_0.dll">
