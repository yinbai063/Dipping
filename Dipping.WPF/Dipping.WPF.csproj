  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dipping.Core\Dipping.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="MvVSControlSDK.Net">
      <HintPath>Libs\MvVSControlSDK.Net.dll</HintPath>
